{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,

        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,

        "strict": true,
        "noImplicitAny": false,

        "jsx": "preserve",
        "jsxImportSource": "vue",

        "types": ["vitest/globals"],

        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "tests/**/*.ts",
        "vite.config.ts"
    ]
}
