{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": false,
        "outDir": "dist",
        "stripInternal": true
    },
    "include": [
        "src/index.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue"
    ],
    "exclude": [
        "tests",
        "node_modules",
        "dist"
    ]
}
